# Copy to .env and fill in. .env is gitignored: never commit it.

# Postgres for the Docker Compose stack.
POSTGRES_USER=hubnisio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hubnisio

# Used when running the backend outside Docker (from backend/), against the Compose database.
HUBNISIO_DATABASE_URL=postgresql://hubnisio:change-me@localhost:5432/hubnisio

# The user the API acts as until passkey login exists (ADR-0004). Create it once with the
# bootstrap command in the README.
HUBNISIO_DEV_USER_EMAIL=you@example.com

# Enable Banking application ID, from its Control Panel. The private key goes in
# secrets/enable-banking.pem, not here.
HUBNISIO_ENABLE_BANKING_APP_ID=
